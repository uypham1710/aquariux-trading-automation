{
  "name": "aquariux-trading-automation",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation assessment for the Aquariux web trading platform (Playwright + TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
